# Copy to .env and fill in. .env is gitignored.

# Required for any phase that calls Anthropic.
ANTHROPIC_API_KEY=

# Default model. Override per-phase if needed.
AGENT_MODEL=claude-sonnet-4-5

# Langfuse (Phase 6+). Self-hosted or cloud.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Phase 7 — production patterns.
# Postgres for LangGraph checkpointer / audit log.
POSTGRES_URL=postgresql://localhost:5432/agent_engineering

# Slack webhook for HITL approvals (Phase 7).
SLACK_HITL_WEBHOOK=
